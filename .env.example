# ---------------------------------------------------------------------------------------------
# LOCAL DEVELOPMENT (default: `.env`, git-ignored). Values come from `npx supabase status -o env`
# of YOUR LOCAL stack. Never put hosted credentials in this file.
# ---------------------------------------------------------------------------------------------
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_KEY=<local publishable key (sb_publishable_...)>
# server-only — never exposed to the browser bundle
NUXT_SUPABASE_SECRET_KEY=<local secret key (sb_secret_...)>
NUXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# development payment simulator (refused when NODE_ENV=production)
NUXT_ALLOW_DEV_PAYMENT_SIMULATOR=true
# media backends enabled here (local default: supabase,external)
NUXT_MEDIA_ENABLED_PROVIDERS=supabase,external

# ---------------------------------------------------------------------------------------------
# PAYMENTS (server-only). Leave EMPTY until the owner supplies authorised sandbox credentials; never reuse a key found in the legacy code.
# Full procedure: docs/implementation/PAYMENTS_GO_LIVE_CHECKLIST.md. Real gateways stay NOT VERIFIED and live stays off until you flip the switches below.
# ---------------------------------------------------------------------------------------------
# NUXT_PAYMENTS_ENABLED_PROVIDERS=paymob,tap         # production default; local default also lists dev_simulator
# NUXT_PAYMENTS_PUBLIC_BASE_URL=https://preview.example.com   # public https origin the gateways call back to (they cannot reach localhost)
# NUXT_PAYMENTS_LIVE_ENABLED=false                   # the owner's explicit live switch (the provider's *_VERIFIED must also be true)
# Paymob (KSA): sandbox key set, then live key set. INTEGRATION_IDS is a comma list.
# NUXT_PAYMOB_TEST_SECRET_KEY=
# NUXT_PAYMOB_TEST_PUBLIC_KEY=
# NUXT_PAYMOB_TEST_HMAC_SECRET=
# NUXT_PAYMOB_TEST_INTEGRATION_IDS=
# NUXT_PAYMOB_LIVE_SECRET_KEY=
# NUXT_PAYMOB_LIVE_PUBLIC_KEY=
# NUXT_PAYMOB_LIVE_HMAC_SECRET=
# NUXT_PAYMOB_LIVE_INTEGRATION_IDS=
# NUXT_PAYMOB_REGION=ksa                             # the regional Paymob account: ksa | egypt | uae | oman
# NUXT_PAYMOB_CURRENCY=USD                           # REQUIRED confirmation of the currency your integration charges in; must equal the store currency (USD). Unset = Paymob is not offered. No conversion is ever applied
# NUXT_PAYMOB_VERIFIED=false                         # set true ONLY after an authorised end-to-end sandbox run passed
# Tap
# NUXT_TAP_TEST_SECRET_KEY=
# NUXT_TAP_LIVE_SECRET_KEY=
# NUXT_TAP_CURRENCY=USD                              # REQUIRED confirmation of the currency your Tap merchant account charges in; must equal the store currency. Unset = Tap is not offered
# NUXT_TAP_VERIFIED=false

# Hosted configuration lives in a SEPARATE file: copy `.env.hosted.example` to `.env.hosted` (also git-ignored) and run
# `npm run dev:hosted`. The server refuses to start against any Supabase project other than the authorised AAWRAQ one.
