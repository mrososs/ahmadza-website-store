# Copy to .env (git-ignored) and fill from `npx supabase status -o env` of YOUR LOCAL stack.
# Never put hosted-project credentials here. Never commit .env.
NUXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NUXT_PUBLIC_SUPABASE_KEY=<local publishable key (sb_publishable_...)>
# server-only — never expose to the browser bundle
NUXT_SUPABASE_SECRET_KEY=<local secret key (sb_secret_...)>
NUXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# development payment simulator (refused when NODE_ENV=production)
NUXT_ALLOW_DEV_PAYMENT_SIMULATOR=true
