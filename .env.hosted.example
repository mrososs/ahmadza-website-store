# HOSTED Supabase (project ref ubjuyeccioflhpcpnhmo — the ONLY authorised AAWRAQ project).
# Copy to `.env.hosted` (git-ignored). Fill the two keys from the dashboard: Project Settings -> API Keys.
# NEVER commit real values. NEVER use the owner's personal-website project (`ahmadza-web`).
NUXT_PUBLIC_SUPABASE_URL=https://ubjuyeccioflhpcpnhmo.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=<publishable key (sb_publishable_...)  — safe for browsers, protected by RLS>
# server-only secret key: Nitro runtime only, never the browser, never the repository
NUXT_SUPABASE_SECRET_KEY=<secret key (sb_secret_...)>
# set to the real address of the running app (used for referral links and auth redirects); local value while developing
NUXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
# the development payment simulator must stay OFF against the hosted project
NUXT_ALLOW_DEV_PAYMENT_SIMULATOR=false
# hosted default: no Supabase-stored PDFs (the VPS adapter does not exist yet) — only external https links
NUXT_MEDIA_ENABLED_PROVIDERS=external
# private media service (docs/implementation/VPS_SECURITY_GATE.md) — add `vps` to NUXT_MEDIA_ENABLED_PROVIDERS ONLY after that gate passes.
# NUXT_VPS_STORAGE_BASE_URL=https://files.example.com
# NUXT_VPS_STORAGE_SIGNING_SECRET=<>=32 random chars, server-only, same value as MEDIA_SIGNING_SECRETS on the service>
# NUXT_VPS_STORAGE_UPLOAD_TOKEN=<>=32 random chars, server-only, same value as MEDIA_UPLOAD_TOKEN on the service>
