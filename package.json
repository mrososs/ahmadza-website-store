{
  "name": "aawraq-platform",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "nuxt dev --port 3000",
    "build": "nuxt build",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt prepare && vue-tsc --noEmit -p .nuxt/tsconfig.app.json && vue-tsc --noEmit -p .nuxt/tsconfig.server.json && vue-tsc --noEmit -p .nuxt/tsconfig.shared.json && vue-tsc --noEmit -p .nuxt/tsconfig.node.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:db": "vitest run tests/db",
    "test:api": "vitest run tests/api",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:status": "supabase status",
    "db:types": "supabase gen types typescript --local > shared/types/database.types.ts",
    "ui:shots": "playwright test -c tests/e2e/playwright.config.ts",
    "dev:seed": "node scripts/dev/seed-dev.mjs",
    "migrate:availability": "node scripts/migration/data-availability.mjs",
    "migrate:inventory": "node scripts/migration/media-inventory.mjs --extract",
    "migrate:scan": "powershell -NoProfile -File scripts/migration/scan-quarantine.ps1",
    "migrate:stage": "node scripts/migration/stage-media.mjs",
    "migrate:import": "node scripts/migration/import-legacy.mjs",
    "migrate:reconcile": "node scripts/migration/reconcile.mjs",
    "assets:sync": "node scripts/dev/sync-legacy-assets.mjs",
    "dev:hosted": "nuxt dev --dotenv .env.hosted --port 3000",
    "audit:db": "node scripts/db/run-audit.mjs",
    "hosted:preflight": "node scripts/db/hosted-preflight.mjs",
    "test:hosted": "vitest run -c vitest.hosted.config.ts",
    "db:fingerprint": "node scripts/db/fingerprint.mjs",
    "db:compare": "node scripts/db/compare-fingerprint.mjs",
    "dev:recovery": "nuxt dev --dotenv .env.recovery --port 3100 --extends ./scripts/dev/recovery-layer",
    "dev:hosted:3100": "nuxt dev --dotenv .env.hosted --port 3100 --extends ./scripts/dev/hosted-layer"
  },
  "dependencies": {
    "@nuxtjs/supabase": "^2.1.0",
    "@pinia/nuxt": "^1.0.3",
    "@supabase/supabase-js": "^2.58.0",
    "h3": "^1.15.11",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "sanitize-html": "^2.17.0",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "@types/node": "^24.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/sanitize-html": "^2.16.0",
    "eslint": "^9.0.0",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.14.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "supabase": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.0.0"
  }
}
